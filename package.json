		"@babel/preset-react": "^8.0.1",
		"@wordpress/postcss-plugins-preset": "^5.51.0",
		"@wordpress/prettier-config": "^4.51.0",
		"babel-loader": "^10.1.1",
		"babel-plugin-polyfill-corejs3": "^1.0.0",
		"browserslist": "^4.28.7",
		"clean-webpack-plugin": "^4.0.0",
		"core-js": "^3.49.0",
		"core-js-compat": "^3.49.0",
		"css-loader": "^7.1.4",
		"cssnano": "^8.0.2",
